# =====================================================================
# Polymarket BTC 5m up/down trading bot — configuration
# Copy this file to `.env` and edit. Empty values fall back to the defaults shown.
# =====================================================================

# ---------------------------------------------------------------------
# Polymarket — only required when you actually start trading (Phase 4).
# Leave empty for Phases 1–3 (data collection, fair-value model, paper trading).
# ---------------------------------------------------------------------
# Your Polygon wallet private key (hex, starts with 0x, 66 chars total). NEVER commit.
# Use a DEDICATED wallet with only the small test amount you can afford to lose.
# Get it from MetaMask: Account menu → Account details → Show private key.
POLYMARKET_PRIVATE_KEY=

# The address that HOLDS your pUSD trading balance — your Polymarket proxy wallet.
#
# Find it at: https://polymarket.com/settings  (NOT Profile or Builders pages)
# Polymarket auto-deploys a Gnosis Safe proxy for every user on first login. This is the
# address that actually owns your pUSD and places orders. It is DIFFERENT from your
# MetaMask address.
#
# The addresses on Polymarket's "Profile" and "Builders" pages are labeled "For API use only"
# and do NOT hold funds — do not use those.
POLYMARKET_FUNDER_ADDRESS=

# Optional: your Polymarket Builder code (hex, from Builders page).
# Attach to orders so trades earn the builder fee rebate. Leave empty if no builder profile.
POLYMARKET_BUILDER_CODE=

# ---------------------------------------------------------------------
# Public endpoints — the defaults are usually fine.
# ---------------------------------------------------------------------
# ---------------------------------------------------------------------
# Telegram notifications (optional)
# ---------------------------------------------------------------------
# How to set up:
#   1. Message @BotFather on Telegram, send /newbot, follow prompts → get bot token
#   2. Message your new bot at least once (so it can DM you)
#   3. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates → find your chat id
#   4. Paste both below
# Leave both empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# BTC price source for the model.
# - chainlink (default): Polymarket's RTDS routes the same Chainlink BTC/USD price the market
#   resolves on. Eliminates source-basis errors between the bot's view and the market outcome.
# - binance: BTC/USDT from Binance WebSocket. Higher frequency but can disagree with Polymarket
#   resolution (we saw $200+ basis live). Useful for comparison only.
BTC_PRICE_SOURCE=chainlink

# ---------------------------------------------------------------------
# Data collector
# ---------------------------------------------------------------------
DB_PATH=./data/ticks.sqlite
# How often (ms) to poll Polymarket's order book. Default 5000 = every 5 seconds.
# Lower = more data + more responsive, but more API calls.
TICK_INTERVAL_MS=5000
LOG_LEVEL=info

# =====================================================================
# Strategy parameters
# =====================================================================
# These control WHEN the bot decides to take a trade.
# After collecting some data, look at the backtest output and tune these.
# ---------------------------------------------------------------------

# How much total money the strategy is allowed to deploy, in USD.
# Used by the Kelly sizer to figure out position sizes — NOT a deposit amount.
# For Phase 3 (paper trading) you can use any number you like; it just scales the simulated P&L.
# Higher = bigger positions per trade; Lower = smaller.
STRATEGY_BANKROLL_USD=1000

# Kelly multiplier. Full Kelly = 1.0 (mathematically maximizes growth — but ruinous if your edge
# estimate is wrong). Practical range: 0.1–0.5. Quarter Kelly (0.25) is the standard safe choice.
# Lower = smaller bets, slower account growth, but much more forgiving of model error.
STRATEGY_KELLY_FRACTION=0.25

# Minimum edge required to take a trade.
# "Edge" = the bot's predicted win probability minus the price you'd pay.
# Example: if the bot thinks "Up" is 62% likely and you can buy "Up" at 0.55 (i.e. 55¢),
#          edge = 0.62 - 0.55 = 0.07 (= 7 percentage points).
# Default 0.05 means the bot will skip trades with less than a 5pp edge.
# Higher = fewer trades but each one is more confident; Lower = more trades, more noise.
STRATEGY_MIN_EDGE=0.05

# Maximum bid-ask spread on the side being traded.
# Spread = bestAsk - bestBid. A wide spread usually means a stale or thin order book.
# Default 0.03 means "skip if the spread is wider than 3¢ on a $1 contract".
# Higher = trade more illiquid markets (worse fills); Lower = stricter (fewer but cleaner trades).
STRATEGY_MAX_SPREAD=0.03

# Minimum seconds left in the window to take a new trade.
# Too close to resolution and there's no time for the price to converge to your fair-value estimate.
# Default 30s.
STRATEGY_MIN_REMAINING_SEC=30

# Maximum seconds left in the window to take a new trade.
# Early in a 5-min window the volatility estimate is unstable and the price hasn't moved much.
# Default 270s (skip first 30s of each window — windows are 300s = 5 minutes).
STRATEGY_MAX_REMAINING_SEC=270

# =====================================================================
# Risk limits — these are HARD STOPS that override the strategy
# =====================================================================

# Max simultaneous open positions. Each 5m window can produce a position; this caps overlap.
RISK_MAX_OPEN_POSITIONS=3

# Hard cap on USD at risk per single trade — Kelly can never exceed this.
# "Risk" = the dollar amount you lose if the trade is wrong (taker_price × shares).
# Start small ($5) while building confidence; raise once the backtest shows real edge.
RISK_MAX_PER_TRADE_USD=5

# If realized losses for the day reach this many USD, stop opening new trades until UTC midnight.
RISK_MAX_DAILY_LOSS_USD=100

# Hard cap on number of windows traded per day (UTC). Catches runaway-bug scenarios.
RISK_MAX_WINDOWS_PER_DAY=200

# Percentage drawdown of bankroll that halts trading for the day.
# 0.10 = stop if you've lost 10% of bankroll. Whichever hits first (this or RISK_MAX_DAILY_LOSS_USD).
RISK_STOP_AT_DAILY_LOSS_PCT=0.10

# =====================================================================
# Phase 4 — LIVE TRADING (real money). READ CAREFULLY.
# =====================================================================
# Triple-safety design: by default everything below is OFF.
# To actually trade for real, you must:
#   1. Set LIVE_TRADING=true                — turns on the LiveTrader init
#   2. Run `npm run live-smoke-test`        — confirms auth + balance
#   3. Run `npm run live-test-order`        — places ONE $1 test order
#   4. Confirm the test order behaves correctly on Polymarket UI
#   5. Set LIVE_DRY_RUN=false               — real orders begin
# ---------------------------------------------------------------------

# Master switch. false (default) = paper trading only.
# true = the LiveTrader initializes alongside main.ts, but still respects LIVE_DRY_RUN.
LIVE_TRADING=false

# Even when LIVE_TRADING=true, this MUST be false for real orders to be placed.
# Keep true while testing — orders are logged but not posted.
LIVE_DRY_RUN=true

# Hard ceiling on USD per live trade — much tighter than the paper-trading risk cap.
# Starts at $2; raise gradually once you've watched ~20 live trades execute correctly.
LIVE_MAX_TRADE_USD=2

# Polymarket signature type.
# - POLY_1271 (default): post-CLOB-v2 deposit-wallet users. ALL new polymarket.com users get this,
#                        including MetaMask logins. Run `npm run find-proxy` to derive the funder
#                        address from your EOA.
# - POLY_GNOSIS_SAFE:    pre-CLOB-v2 Safe users (rare now).
# - POLY_PROXY:          legacy Magic Link (email/Google) accounts.
# - EOA:                 pure EOA trading (no proxy). Rare on polymarket.com.
LIVE_SIGNATURE_TYPE=POLY_1271
