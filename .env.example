# ─── Binance USDT-M Futures API ────────────────────────────────────────────
# Each venue has its OWN keys (NOT interchangeable). testnet keys fall back to
# BINANCE_API_* if the TESTNET_* ones are blank.

# MAINNET keys — `npm run live` (real money). Futures enabled, withdrawals OFF, IP-whitelisted.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com

# TEST-VENUE keys — `npm run testnet` (risk-free). The Binance futures sandbox is
# now "Demo Trading" (demo.binance.com → demo-fapi.binance.com); the old
# testnet.binancefuture.com redirects here. Realistic prices, but it rejects
# STOP_MARKET (bot manages stops on candle close). Get keys from demo.binance.com.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
BINANCE_TESTNET_WS_URL=wss://demo-fstream.binance.com

# ─── Mode ──────────────────────────────────────────────────────────────────
# backtest | paper | live  (only `backtest` reads this; testnet/live set the venue)
MODE=backtest
# Hard safety: must be true for `npm run live` to send REAL mainnet orders. Default off.
ALLOW_LIVE=false

# ─── Storage ───────────────────────────────────────────────────────────────
DB_PATH=./data/binance.sqlite
LOG_LEVEL=info

# ─── Risk model ────────────────────────────────────────────────────────────
RISK_PCT=0.01               # fraction of equity risked per trade (1%)
LEVERAGE=10                 # per-symbol leverage (kept low; risk is set by stop)
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.05     # kill switch: halt new entries past this daily loss
TAKER_FEE=0.0004           # 0.04% per side, used in cost model
SLIPPAGE_BPS=5             # assumed slippage/side (bps), backtest/paper only — see config.ts

# ─── Real-money sizing & guardrails (M8) ───────────────────────────────────
RISK_USDT=0                 # fixed USDT risk/trade; >0 OVERRIDES RISK_PCT (use ~1 for first live phase)
MAX_TRADE_RISK_USDT=0       # hard ceiling on risk per trade (0 = off)
MAX_NOTIONAL_PER_TRADE=0    # hard ceiling on notional per trade (0 = off)
CONFIRM_LIVE=false          # SECOND key (besides ALLOW_LIVE) required for `npm run live`

# ─── Ops: dashboard / backup / alerts (M9) ─────────────────────────────────
DASHBOARD_PORT=8787
BACKUP_DIR=./data/backups
TELEGRAM_BOT_TOKEN=         # optional; blank disables alerts
TELEGRAM_CHAT_ID=

# ─── Strategy ──────────────────────────────────────────────────────────────
TIMEFRAME=1h
# TP split: take TAKE1 at +1R, TAKE2 at +2R, trail the rest (1−TAKE1−TAKE2).
ADX_MIN=25
TRAIL_MULT=3
COOLDOWN=24
TAKE1=0.3
TAKE2=0.3
# Lifecycle time-stops (0 = disabled; the guardian + trend-flip close handle stale trades).
MAX_HOLD_BARS=0
STALL_BARS=0
MAX_TOTAL_BARS=0

# ─── Guardian (intra-candle monitor; live-only, not in the backtest) ────────
MONITOR_ENABLED=true
MONITOR_INTERVAL_MIN=1       # check open positions every N minutes between hourly ticks
MONITOR_REVERSAL_MODE=warn   # off | warn | exit — action on a faster-TF EMA50/200 trend flip
MONITOR_REVERSAL_TF=15m      # timeframe for the reversal check

# ─── Universe ──────────────────────────────────────────────────────────────
UNIVERSE_MODE=static        # static (SYMBOLS) | dynamic (top-N by 24h volume)
UNIVERSE_SIZE=50
MIN_24H_VOLUME=50000000
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
DENYLIST=
