# Dependencies
node_modules/

# Build output
dist/
build/

# Secrets / environment (NEVER commit — contains API keys)
.env
.env.local
.env.*.local
*.key
*.pem

# Data: databases, ticks, backtest output, backups.
# `data/*` (not `data/`) so the journal snapshot below can be re-included —
# git cannot un-ignore a file whose parent DIRECTORY is excluded.
data/*
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# The ONE tracked database: the live trade journal (64KB), committed by the
# server's daily cron (scripts/journal-push.sh) so it syncs home via git.
# The cron runs `PRAGMA wal_checkpoint(TRUNCATE)` first so the main file is
# complete at copy time. Caveats accepted by design: a commit can be a few
# minutes stale, and a torn copy is theoretically possible but self-heals on
# the next day's push — the DB the bot writes is never touched by git itself.
# The -wal/-shm sidecars stay ignored (committing those WOULD corrupt).
!data/live.sqlite

# Logs
*.log
logs/
npm-debug.log*

# Editor / IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
